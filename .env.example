# Copy this file to .env and fill in the values.
# The .env file is listed in .gitignore and will never be committed.

# Your API key.
# For real OpenAI: get this from https://platform.openai.com/api-keys (starts with sk-...)
# For GPUStack or other self-hosted services: use the token generated by that service.
OPENAI_API_KEY=

# The base URL of the OpenAI-compatible API endpoint.
# Leave this blank (or remove it) to use the official OpenAI API (api.openai.com).
# For a self-hosted service set it to that service's URL, for example:
#   API_BASE_URL=https://gpustack.example.com/v1
API_BASE_URL=

# The name of the model you want to use.
# Examples: gpt-4o, gpt-4o-mini (OpenAI) or whatever your service exposes.
MODEL_NAME=
